# Server
PORT=3000
NODE_ENV=development

# Database (SQLite)
DATABASE_PATH=./data/reos.db

# Slack (https://api.slack.com/apps)
# Bot User OAuth Token (xoxb-...)
SLACK_BOT_TOKEN=
# Signing Secret from the app's "Basic Information" page
SLACK_SIGNING_SECRET=
# Default channel for outbound notifications (e.g. #reos-bildirim)
SLACK_DEFAULT_CHANNEL=#general

# Bulutfon call notifications channel ID (C...). Bot must be a member.
SLACK_CALLS_CHANNEL=

# WhatsApp Cloud API (https://developers.facebook.com/docs/whatsapp/cloud-api)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_LANG=tr
# Approved template names (leave empty to send plain text)
WHATSAPP_TEMPLATE_KARSILAMA=
WHATSAPP_TEMPLATE_CEVAPSIZ=

# Call follow-up messages ({office} is replaced with OFFICE_NAME)
OFFICE_NAME=Snow Art Gayrimenkul
CALL_MESSAGE_DEDUPE_HOURS=24
CALL_KARSILAMA_TEXT=
CALL_CEVAPSIZ_TEXT=
